# Скопировать в deploy/.env на сервере и заполнить. В git .env не попадает никогда.
POTOK51_PORT=8051

# HTTP Basic на уровне приложения. Если обе переменные пусты — авторизация выключена;
# в этом случае сервис обязан быть закрыт снаружи (firewall или reverse proxy).
POTOK51_BASIC_USER=analyst
POTOK51_BASIC_PASSWORD=

# Каталог хранения анализов внутри контейнера. Смонтирован на том potok51_data.
POTOK51_DATA_DIR=/data

# Префикс обратного прокси, если сервис опубликован не в корне домена.
# Пример для Caddy с handle_path /potok51/* — укажите /potok51
POTOK51_BASE_PATH=
